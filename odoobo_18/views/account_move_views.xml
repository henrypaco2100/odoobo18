<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_esi_comprobante_v18" model="ir.ui.view">
        <field name="name">account.move.form.esi.comprobante.v18</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- ESI adaptación Odoo 18: attrs ya no se utiliza; se usa invisible directo. -->
            <xpath expr="//header" position="inside">
                <button name="action_esi_comprobante_preview"
                        type="object"
                        string="Vista comprobante"
                        class="oe_highlight"
                        invisible="state != 'posted'"
                        groups="account.group_account_invoice,account.group_account_user"/>
                <button name="action_esi_comprobante_pdf"
                        type="object"
                        string="PDF comprobante"
                        invisible="state != 'posted'"
                        groups="account.group_account_invoice,account.group_account_user"/>
            </xpath>

            <!-- Odoo 18 tiene dos páginas Other Info: una para facturas y otra para asientos. -->
            <xpath expr="//page[@id='other_tab']/group[@id='other_tab_group']" position="inside">
                <group string="Comprobante Contable" name="esi_comprobante_options_invoice"
                       groups="account.group_account_invoice,account.group_account_user">
                    <field name="esi_check_number"/>
                    <field name="esi_show_line_date"/>
                    <field name="esi_show_analytic"/>
                </group>
            </xpath>

            <xpath expr="//page[@id='other_tab_entry']/group[@id='other_tab_entry_group']" position="inside">
                <group string="Comprobante Contable" name="esi_comprobante_options_entry"
                       groups="account.group_account_invoice,account.group_account_user">
                    <field name="esi_check_number"/>
                    <field name="esi_show_line_date"/>
                    <field name="esi_show_analytic"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
