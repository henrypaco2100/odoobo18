<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_esi_remision_v18" model="ir.ui.view">
        <field name="name">stock.picking.form.esi.remision.v18</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!--
                ESI Odoo 18: las opciones se colocan en Información adicional,
                en la misma sección indicada por el usuario. Son editables incluso
                después de validar porque únicamente controlan la impresión.
            -->
            <xpath expr="//page[@name='extra']/group/group[@name='other_infos']" position="after">
                <group string="Remision / Opciones de impresion" name="esi_remision_print_options">
                    <field name="esi_remission_percentage"/>
                    <field name="esi_print_cost"/>
                    <field name="esi_print_cost_total"/>
                    <field name="esi_print_amount_total"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
