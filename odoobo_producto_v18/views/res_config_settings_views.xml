<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESI corrección Odoo 18: sección independiente para configurar 10 etiquetas. -->
    <record id="res_config_settings_view_form_esi_product_v18" model="ir.ui.view">
        <field name="name">res.config.settings.form.odoobo.product.v18</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="priority" eval="60"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='general_settings']" position="after">
                <app data-string="Campos Producto Odoobo"
                     string="Campos Producto Odoobo"
                     name="odoobo_product_fields"
                     logo="/product/static/description/icon.png"
                     groups="base.group_no_one">
                    <block title="Nombres de los 10 campos adicionales de producto"
                           name="odoobo_product_fields_labels">
                        <setting id="odoobo_product_field_1_label_setting"
                                 string="Nombre del campo adicional 1"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_1_label"/>
                        </setting>
                        <setting id="odoobo_product_field_2_label_setting"
                                 string="Nombre del campo adicional 2"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_2_label"/>
                        </setting>
                        <setting id="odoobo_product_field_3_label_setting"
                                 string="Nombre del campo adicional 3"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_3_label"/>
                        </setting>
                        <setting id="odoobo_product_field_4_label_setting"
                                 string="Nombre del campo adicional 4"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_4_label"/>
                        </setting>
                        <setting id="odoobo_product_field_5_label_setting"
                                 string="Nombre del campo adicional 5"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_5_label"/>
                        </setting>
                        <setting id="odoobo_product_field_6_label_setting"
                                 string="Nombre del campo adicional 6"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_6_label"/>
                        </setting>
                        <setting id="odoobo_product_field_7_label_setting"
                                 string="Nombre del campo adicional 7"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_7_label"/>
                        </setting>
                        <setting id="odoobo_product_field_8_label_setting"
                                 string="Nombre del campo adicional 8"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_8_label"/>
                        </setting>
                        <setting id="odoobo_product_field_9_label_setting"
                                 string="Nombre del campo adicional 9"
                                 help="Modifica únicamente el nombre mostrado. El nombre técnico del campo no cambia.">
                            <field name="esi_product_field_9_label"/>
                        </setting>
                        <setting id="odoobo_product_field_10_label_setting"
                                 string="Nombre del campo adicional 10"
                                 help="Después de guardar, vuelva a abrir o recargue el producto para visualizar el nuevo nombre.">
                            <field name="esi_product_field_10_label"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
