<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ESI Odoo 18: ir.actions.report usa group_ids. -->
    <record id="paperformat_comprobante_contable_v18" model="report.paperformat">
        <field name="name">ESI Comprobante Contable Carta Odoo 18</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">6</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_comprobante_contable_pdf" model="ir.actions.report">
        <field name="name">Comprobante Contable (PDF)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">odoobo_18.comprobante_contable_document</field>
        <field name="report_file">odoobo_18.comprobante_contable_document</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_comprobante_contable_v18"/>
        <field name="print_report_name">object.esi_report_filename()</field>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
    </record>

    <record id="action_comprobante_contable_html" model="ir.actions.report">
        <field name="name">Comprobante Contable (Vista)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">odoobo_18.comprobante_contable_document</field>
        <field name="report_file">odoobo_18.comprobante_contable_document</field>
        <field name="paperformat_id" ref="paperformat_comprobante_contable_v18"/>
        <field name="group_ids" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_user'))]"/>
    </record>
</odoo>
