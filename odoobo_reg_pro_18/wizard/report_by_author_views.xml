<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_odoobo_report_by_author_form" model="ir.ui.view">
        <field name="name">odoobo.report.by.author.form</field>
        <field name="model">odoobo.report.by.author</field>
        <field name="arch" type="xml">
            <form string="Kardex / Informe por Autor">
                <sheet>
                    <group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group>
                            <field name="autor_id" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="product_id" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group invisible="not excel_file">
                        <field name="file_name" invisible="1"/>
                        <field name="excel_file" filename="file_name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_export_xlsx" type="object" string="Imprimir Excel" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_odoobo_report_by_author" model="ir.actions.act_window">
        <field name="name">Kardex por Autor</field>
        <field name="res_model">odoobo.report.by.author</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_odoobo_report_by_author_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_odoobo_report_by_author"
              name="Kardex por Autor"
              parent="stock.menu_warehouse_report"
              action="action_odoobo_report_by_author"
              sequence="400"
              groups="stock.group_stock_user"/>
</odoo>
