<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_nota_remision">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'NOTA DE REMISION'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>
    <template id="report_entrega_consignacion">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE CONSIGNACION'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>
    <template id="report_entrega_materiales">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'ENTREGA DE MATERIALES'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>
    <template id="report_recepcion_consignacion">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'RECEPCION DE CONSIGNACION'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>
    <template id="report_devolucion_proveedores">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCION DE PROVEEDORES'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>
    <template id="report_devolucion_librerias">
        <t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="esi_title" t-value="'DEVOLUCION DE LIBRERIAS'"/><t t-call="odoobo_remision_v18.report_remision_body"/></t></t>
    </template>

    <template id="esi_company_header">
        <t t-set="company" t-value="o.company_id"/>
        <table style="width:94%; margin:0 auto 2mm auto; border-collapse:collapse; border:0; table-layout:fixed;">
            <tr style="height:24mm;">
                <td style="width:50%; vertical-align:top; border:0; padding:1mm 0 0 3mm;">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" alt="Logo"
                         style="max-height:17mm; max-width:39mm; width:auto; height:auto;"/>
                </td>
                <td style="width:50%; vertical-align:top; text-align:right; border:0; padding:0 2mm 0 0; font-family:Arial, Helvetica, sans-serif; font-size:7.5pt; line-height:1.45;">
                    <div style="font-weight:700; font-size:8pt;" t-out="o.esi_report_text(company.name or '', report_type)"/>
                    <div t-if="company.vat"><strong>NIT: </strong><span t-out="o.esi_report_text(company.vat, report_type)"/></div>
                    <div t-if="company.phone"><strong>Tel: </strong><span t-out="o.esi_report_text(company.phone, report_type)"/></div>
                    <div t-if="company.partner_id.city or company.partner_id.country_id">
                        <span t-out="o.esi_report_text(company.partner_id.city or '', report_type)"/>
                        <t t-if="company.partner_id.city and company.partner_id.country_id"> - </t>
                        <span t-out="o.esi_report_text(company.partner_id.country_id.name or '', report_type)"/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_remision_body">
        <div class="page" style="width:100%; margin:0; padding:0; color:#000; font-family:Arial, Helvetica, sans-serif; font-size:8pt;">
            <t t-call="odoobo_remision_v18.esi_company_header"/>

            <div style="width:100%; text-align:center; margin:1mm 0 4mm 0;">
                <span style="font-size:11pt; font-weight:400; text-decoration:underline;" t-out="o.esi_report_text(esi_title, report_type)"/>
            </div>

            <table style="width:90%; margin:0 auto 6mm auto; border-collapse:collapse; border:0; table-layout:fixed; font-size:8pt; line-height:1.45;">
                <colgroup>
                    <col style="width:12%;"/><col style="width:38%;"/>
                    <col style="width:14%;"/><col style="width:36%;"/>
                </colgroup>
                <tr>
                    <td style="border:0; padding:0.25mm 0;">FECHA:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.esi_date_in_words(), report_type)"/></td>
                    <td style="border:0; padding:0.25mm 0;">WH_ORIGEN:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.location_id.display_name, report_type)"/></td>
                </tr>
                <tr>
                    <td style="border:0; padding:0.25mm 0;">SENORES:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.partner_id.name or '', report_type)"/></td>
                    <td style="border:0; padding:0.25mm 0;">WH_DESTINO:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.location_dest_id.display_name, report_type)"/></td>
                </tr>
                <tr>
                    <td style="border:0; padding:0.25mm 0;">NUMERO:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.name, report_type)"/></td>
                    <td style="border:0; padding:0.25mm 0;">PORCENTAJE:</td>
                    <td style="border:0; padding:0.25mm 1mm;"><strong t-out="o.esi_report_text(o.esi_percentage_label() or '', report_type)"/></td>
                </tr>
            </table>

            <!-- ESI: columnas opcionales desde Información adicional del picking. -->
            <table style="width:94%; margin:0 auto; border-collapse:collapse; table-layout:fixed; font-size:7.2pt; line-height:1.25;">
                <thead>
                    <tr style="text-align:center; background:#e6e9ed; font-weight:700;">
                        <th style="width:10%; border:0.45pt solid #444; padding:1mm 0.7mm;">CANTIDAD</th>
                        <th style="border:0.45pt solid #444; padding:1mm 0.7mm;">TITULO</th>
                        <th style="width:12%; border:0.45pt solid #444; padding:1mm 0.7mm;">PVP</th>
                        <th t-if="o.esi_print_cost" style="width:12%; border:0.45pt solid #444; padding:1mm 0.7mm;">COSTO</th>
                        <th t-if="o.esi_print_cost_total" style="width:14%; border:0.45pt solid #444; padding:1mm 0.7mm;">COSTO TOTAL</th>
                        <th t-if="o.esi_print_amount_total" style="width:14%; border:0.45pt solid #444; padding:1mm 0.7mm;">IMPORTE TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="o.esi_report_moves()" t-as="line">
                        <td style="border:0.45pt solid #444; padding:0.8mm 0.7mm; text-align:center;" t-out="o.esi_format_quantity(o.esi_move_quantity(line))"/>
                        <td style="border:0.45pt solid #444; padding:0.8mm 0.7mm; word-wrap:break-word;" t-out="o.esi_report_text(line.product_id.display_name, report_type)"/>
                        <td style="border:0.45pt solid #444; padding:0.8mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_unit_pvp(line))"/>
                        <td t-if="o.esi_print_cost" style="border:0.45pt solid #444; padding:0.8mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_unit_cost(line))"/>
                        <td t-if="o.esi_print_cost_total" style="border:0.45pt solid #444; padding:0.8mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_line_cost_total(line))"/>
                        <td t-if="o.esi_print_amount_total" style="border:0.45pt solid #444; padding:0.8mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_line_amount_total(line))"/>
                    </tr>
                </tbody>
                <tfoot>
                    <tr style="background:#e6e9ed; font-weight:700;">
                        <td style="border:0.45pt solid #444; padding:1mm 0.7mm; text-align:center;" t-out="o.esi_format_quantity(o.esi_total_quantity())"/>
                        <td style="border:0.45pt solid #444; padding:1mm 0.7mm;">TOTAL</td>
                        <td style="border:0.45pt solid #444; padding:1mm 0.7mm;"></td>
                        <td t-if="o.esi_print_cost" style="border:0.45pt solid #444; padding:1mm 0.7mm;"></td>
                        <td t-if="o.esi_print_cost_total" style="border:0.45pt solid #444; padding:1mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_total_cost())"/>
                        <td t-if="o.esi_print_amount_total" style="border:0.45pt solid #444; padding:1mm 0.7mm; text-align:right; white-space:nowrap;" t-out="o.esi_format_amount(o.esi_total_amount())"/>
                    </tr>
                </tfoot>
            </table>

            <table style="width:90%; margin:7mm auto 0 auto; border-collapse:collapse; border:0; table-layout:fixed; page-break-inside:avoid; font-size:8pt;">
                <tr style="height:40mm;">
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>ELABORADO</strong></td>
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>REVISADO</strong></td>
                    <td style="width:18%; border:0; text-align:center; vertical-align:bottom; padding-bottom:1mm;"><strong>AUTORIZADO</strong></td>
                    <td style="width:46%; border:0; vertical-align:top; padding-left:5mm;">
                        <div style="text-align:center; font-weight:700; margin-bottom:8mm;">CONFORMIDAD</div>
                        <table style="width:100%; border-collapse:collapse; border:0; font-size:8pt;">
                            <tr><td style="width:24%; border:0; padding:0 0 4mm 0;">Firma:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:0 0 4mm 0;"></td></tr>
                            <tr><td style="border:0; padding:4mm 0;">Aclaracion:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:4mm 0;"></td></tr>
                            <tr><td style="border:0; padding:4mm 0 0 0;">Documento:</td><td style="border:0; border-bottom:0.6pt solid #222; padding:4mm 0 0 0;"></td></tr>
                        </table>
                    </td>
                </tr>
            </table>
        </div>
    </template>
</odoo>
