<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_esi_remision_v18" model="ir.ui.view">
        <field name="name">stock.picking.form.esi.remision.v18</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <!-- ESI Odoo 18: campo agregado junto al documento de origen. -->
            <xpath expr="//field[@name='origin']" position="after">
                <field name="esi_remission_percentage" groups="stock.group_stock_user"/>
            </xpath>
        </field>
    </record>
</odoo>
